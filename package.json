{
  "name": "easy-learn",
  "version": "0.0.1",
  "private": true,
  "description": "学习应用",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "electron-vite dev -- --remote-debugging-port=9222",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "debug": "electron-vite dev -- --inspect=5858 --remote-debugging-port=9222",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky",
    "lint": "tsc --noEmit && eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron"
    ],
    "patchedDependencies": {
      "foliate-js@1.0.1": "patches/foliate-js@1.0.1.patch"
    }
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.0",
    "@ai-sdk/openai": "^4.0.1",
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/provider-utils": "^5.0.0",
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hyzyla/pdfium": "^2.1.13",
    "@napi-rs/canvas": "^1.0.9",
    "@paddleocr/api-sdk": "^0.2.3",
    "@pierre/diffs": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@types/mime-types": "^3.0.1",
    "@xmldom/xmldom": "^0.9.10",
    "ai": "^7.0.3",
    "better-sqlite3": "^11.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.0.0",
    "foliate-js": "^1.0.1",
    "jieba-wasm": "^2.4.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.20.0",
    "mathml-to-latex": "^1.8.0",
    "mime-types": "^3.0.2",
    "next-themes": "^0.4.6",
    "openai": "^7.15.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.11.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "typebox": "^1.3.25",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^2.1.9",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.4.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.easylearn.app",
    "productName": "EasyLearn",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
